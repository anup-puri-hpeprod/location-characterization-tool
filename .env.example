# cnx-api-streaming-test configuration
#
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env
#
# The scripts auto-load ".env" (no extra dependency). Already-exported shell
# variables take precedence over the file, so you can still override per run.
# This file is also source-able directly:  set -a; source .env; set +a

# --- OAuth2 API client credentials (from GreenLake Cloud Platform) ---
# Create these under: GreenLake console -> Manage -> API / Personal API Clients.
# Use the account/tenant that owns the target environment (e.g. evian3).
CNX_CLIENT_ID=
CNX_CLIENT_SECRET=

# --- Token issuer (SSO) URL ---
# IMPORTANT: this is environment-specific. Look up the exact "Token Issuer URL"
# (a.k.a. token_url) shown for your API client on the GreenLake Cloud Platform
# and paste it here verbatim. It is NOT always production SSO.
# Examples:
#   Production : https://sso.common.cloud.hpe.com/as/token.oauth2
#   evian3 (QA): https://pavo-sso.common.cloud.hpe.com/as/token.oauth2
CNX_TOKEN_URL=https://pavo-sso.common.cloud.hpe.com/as/token.oauth2

# --- CNX API gateway (websocket) host for the target cluster ---
# Pattern: wss://cnx-apigw-<cluster>.arubadev.cloud.hpe.com
# Examples:
#   aqua   : wss://cnx-apigw-aqua.arubadev.cloud.hpe.com
#   evian3 : wss://cnx-apigw-evian3.arubadev.cloud.hpe.com
CNX_WEBSOCKET_URL=wss://cnx-apigw-evian3.arubadev.cloud.hpe.com
